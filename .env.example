# Senha para entrar no app (obrigatória em produção)
APP_PASSWORD=
# Texto aleatório longo, usado para assinar o cookie de sessão
SESSION_SECRET=

# Postgres (Neon, Supabase, Vercel Postgres...). Sem isso, usa um banco local em .data/
DATABASE_URL=

# Pluggy: dashboard.pluggy.ai → sua aplicação
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Texto aleatório; protege o webhook da Pluggy
WEBHOOK_SECRET=
# URL pública do app, ex.: https://liuliu.vercel.app (usada no webhook)
APP_URL=

# Chat (Ollama). Chave em ollama.com/settings/keys
OLLAMA_API_KEY=
# Opcional: modelo (padrão gpt-oss:120b) e servidor (padrão https://ollama.com)
OLLAMA_MODEL=
OLLAMA_HOST=
# Seu nome, usado nas saudações
USER_NAME=Gabriel

# A Vercel envia este valor ao chamar o cron diário
CRON_SECRET=
